{
  "version": 1,
  "author": "Hrika",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "gas1", "top": -150, "left": -260, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -160, "left": 40, "attrs": {} },
    { "type": "wokwi-flame-sensor", "id": "flame1", "top": 200, "left": -260, "attrs": {} },
    { "type": "wokwi-led", "id": "ledG", "top": -60, "left": 230, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "ledY", "top": -60, "left": 280, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "ledR", "top": -60, "left": 330, "attrs": { "color": "red" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 150, "left": 250, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "gas1:VCC", "esp:3V3", "red", [] ],
    [ "gas1:GND", "esp:GND.1", "black", [] ],
    [ "gas1:AOUT", "esp:34", "orange", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:4", "green", [] ],

    [ "flame1:VCC", "esp:3V3", "red", [] ],
    [ "flame1:GND", "esp:GND.1", "black", [] ],
    [ "flame1:DOUT", "esp:27", "purple", [] ],

    [ "ledG:A", "esp:25", "green", [] ],
    [ "ledG:C", "esp:GND.1", "black", [] ],
    [ "ledY:A", "esp:26", "yellow", [] ],
    [ "ledY:C", "esp:GND.1", "black", [] ],
    [ "ledR:A", "esp:33", "red", [] ],
    [ "ledR:C", "esp:GND.1", "black", [] ],

    [ "bz1:2", "esp:32", "blue", [] ],
    [ "bz1:1", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
